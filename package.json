{
  "name": "markdown-previewer",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" eslint.config.js package.json .prettierrc.json",
    "postinstall": "husky"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.0",
    "@uiw/react-codemirror": "^4.23.0",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.10.0",
    "html-to-pdfmake": "^2.5.36",
    "marked": "^14.1.2",
    "material-symbols": "^0.47.4",
    "mermaid": "^11.12.0",
    "pdfmake": "^0.3.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.8.3",
    "vite": "^6.4.3",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/**/*.css": "prettier --write"
  }
}
